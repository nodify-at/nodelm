# Hugging Face access is optional for public datasets and models.
HF_TOKEN=

# Override deterministic local storage locations only when needed.
NODELM_ARTIFACTS_DIR=artifacts
NODELM_CACHE_DIR=.cache/nodelm
NODELM_LOG_LEVEL=INFO

# Remote hosts are supplied at runtime; never put private keys in this file.
NODELM_SSH_HOST=
NODELM_SSH_USER=
NODELM_SSH_PORT=22
NODELM_SSH_KEY_PATH=
